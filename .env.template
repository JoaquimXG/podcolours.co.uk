# Copy to .env and fill in. Docker compose reads .env automatically, so no
# --env-file flag is needed. Nothing here is built into the image - the values
# are passed to the containers at run time, so the same image can be deployed
# against any environment.
#
# The same .env is also read by dotenv when running the app directly on the
# host without docker. Where the two disagree it is noted below.

# --- Ports ---------------------------------------------------------------
# Port the app listens on inside the container
APPPORT=3000
# Port published on the host
HOSTPORT=8060
# Host interface to publish on. Compose only, not passed to the app.
# Defaults to 127.0.0.1 so a deployment is not reachable from outside the host
# without a reverse proxy in front of it. Set to 0.0.0.0 during local
# development if you need to reach the site from another machine.
#BINDADDR=0.0.0.0

# --- Database ------------------------------------------------------------
MONGODATABASE=podcolours
# Credentials the mongo container is initialised with, and that the app then
# authenticates with. AUTHSOURCE is the database the user is defined in.
MONGOUSER=changeme
MONGOPASSWORD=changeme
AUTHSOURCE=admin

# Leave these unset when running under docker compose - the app reaches mongo
# over the compose network as "mongo" on the default port, and setting them
# here would override that and break the connection. Set them only when running
# the app directly on the host against a local MongoDB installation.
#MONGOHOST=localhost
#MONGOPORT=27017

# --- Secrets -------------------------------------------------------------
# Signs and encrypts session cookies. Unused while ARCHIVEMODE is on, since no
# sessions are created, but required the moment archive mode is switched off.
SESSIONSECRET=changeme

# Password for the relay SMTP server. Only used by password reset and the
# results report email, both of which are off while ARCHIVEMODE is on.
SMTPSECRET=

# --- Archive mode --------------------------------------------------------
# Serves the site as a read-only public archive - no cookies, sessions, logins,
# sign ups or password resets. On by default, including when unset.
# Set to false to restore the fully working site.
ARCHIVEMODE=true

# --- TLS -----------------------------------------------------------------
# Only set these if the app terminates TLS itself, which needs a key and
# certificate in certificates/. Leave unset behind a reverse proxy.
#HTTPS=true
#APPPORTHTTPS=443
